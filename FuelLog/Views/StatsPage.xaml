<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FuelLog.ViewModels"
             xmlns:models="clr-namespace:FuelLog.Models"
             x:Class="FuelLog.Views.StatsPage"
             x:DataType="vm:StatsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Picker Title="Időszak" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" />

            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:StatItem">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Label}" />
                            <Label Grid.Column="1" Text="{Binding Value}" FontAttributes="Bold" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Havi költség (utolsó 6 hónap)" FontAttributes="Bold" Margin="0,16,0,0" />

            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Months}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:MonthStat">
                        <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding Label}" VerticalOptions="Center" FontSize="12" />
                            <BoxView Grid.Column="1" HeightRequest="16" HorizontalOptions="Start"
                                     WidthRequest="{Binding BarWidth}" CornerRadius="4" Color="#512BD4" />
                            <Label Grid.Column="2" Text="{Binding TotalText}" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Exportálás CSV-be és megosztás" Margin="0,20,0,0"
                    Command="{Binding ExportCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>